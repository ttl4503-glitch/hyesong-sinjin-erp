generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id               String   @id @default(cuid())
  company          String
  name             String
  location         String   @default("")
  startDate        String   @default("")
  endDate          String   @default("")
  contractAmount   Float    @default(0)
  progress         Int      @default(0)
  memo             String   @default("")
  completed        Boolean  @default(false)
  workItemsTotal   Float    @default(0)
  workItemsFileName String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  milestones Milestone[]
  laborLogs  LaborLog[]
  workItems  WorkItem[]
  dailyNotes DailyNote[]
}

model Worker {
  id        String   @id @default(cuid())
  name      String   @unique
  jobType   String   @default("")
  idFront   String   @default("") // 주민번호 앞자리 (생년월일, YYMMDD)
  bankName  String   @default("")
  account   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DailyNote {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date      String
  content   String  @default("")

  @@unique([projectId, date])
}

model Milestone {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  date      String  @default("")
  done      Boolean @default(false)
}

model WorkItem {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  spec      String  @default("")
  unit      String  @default("")
  qty       Float   @default(0)
  unitPrice Float   @default(0)
  amount    Float   @default(0)
  isHeader  Boolean @default(false)

  laborLogs LaborLog[]
}

model LaborLog {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type       String
  jobType    String    @default("")
  name       String
  qty        Float     @default(0)
  unit       String    @default("")
  rate       Float     @default(0)
  amount     Float     @default(0)
  date       String    @default("")
  note       String    @default("")
  vendor     String    @default("") // 업체명 (자재/식대/운반비 등)
  taxInvoice Boolean   @default(false)
  workItemId String?
  workItem   WorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  receipt    Receipt?
}

model Receipt {
  id         String   @id @default(cuid())
  laborLogId String   @unique
  laborLog   LaborLog @relation(fields: [laborLogId], references: [id], onDelete: Cascade)
  imageData  String   @db.Text // base64 data URL, compressed client-side before upload
  createdAt  DateTime @default(now())
}
