generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id               String   @id @default(cuid())
  company          String
  name             String
  location         String   @default("")
  startDate        String   @default("")
  endDate          String   @default("")
  contractAmount   Float    @default(0)
  progress         Int      @default(0)
  memo             String   @default("")
  completed        Boolean  @default(false)
  isFixedSite      Boolean  @default(false) // 고정 현장이면 QR 출역 시 출퇴근 시각 기록
  workItemsTotal   Float    @default(0)
  workItemsFileName String?
  sortOrder        Int      @default(0) // 진행중 공사 목록 순서 (작을수록 위)
  deletedAt        DateTime? // 휴지통 (관리자 복구 가능) — null이면 정상
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  milestones Milestone[]
  laborLogs  LaborLog[]
  workItems  WorkItem[]
  dailyNotes DailyNote[]
}

model AppUser {
  id         String   @id @default(cuid())
  name       String   @unique
  pin        String   @default("") // 4자리 숫자 로그인 비밀번호
  isAdmin    Boolean  @default(false)
  projectIds String[] @default([]) // 담당 현장(Project) id 목록 — 관리자는 무시하고 전체 접근
  deletedAt  DateTime? // 휴지통 (관리자 복구 가능) — null이면 정상
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Worker {
  id        String   @id @default(cuid())
  name      String // 동명이인 등록 가능 — 주민번호(idFront)로 구분한다
  jobType   String   @default("")
  idFront   String   @default("") // 주민번호 (전체)
  phone     String   @default("")
  bankName  String   @default("")
  account   String   @default("")
  deletedAt DateTime? // 휴지통 (관리자 복구 가능) — null이면 정상
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DailyNote {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date      String
  content   String  @default("")

  @@unique([projectId, date])
}

model Milestone {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  date      String  @default("")
  done      Boolean @default(false)
}

model WorkItem {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  spec      String  @default("")
  unit      String  @default("")
  qty       Float   @default(0)
  unitPrice Float   @default(0)
  amount    Float   @default(0)
  isHeader  Boolean @default(false)
  level     Int     @default(1)

  laborLogs LaborLog[]
}

model LaborLog {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type       String
  jobType    String    @default("")
  name       String
  qty        Float     @default(0)
  unit       String    @default("")
  rate       Float     @default(0)
  amount     Float     @default(0)
  date       String    @default("")
  note       String    @default("")
  vendor     String    @default("") // 업체명 (자재/식대/운반비 등)
  taxInvoice Boolean   @default(false)
  deletedAt  DateTime? // 휴지통 (관리자 복구 가능) — null이면 정상
  workItemId String?
  workItem   WorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  receipt    Receipt?

  // QR 출역 관련
  source        String        @default("manual") // manual | qr
  checkInAt     DateTime? // 출근(첫 스캔) 시각
  checkOutAt    DateTime? // 퇴근(마지막 스캔) 시각 — 고정 현장만
  checkinPhoto  CheckinPhoto?
}

model CheckinPhoto {
  id         String   @id @default(cuid())
  laborLogId String   @unique
  laborLog   LaborLog @relation(fields: [laborLogId], references: [id], onDelete: Cascade)
  imageData  String   @db.Text // 셀카 (압축된 base64) — 본체와 분리 저장
  gpsLat     Float?
  gpsLng     Float?
  createdAt  DateTime @default(now())
}

model Receipt {
  id         String   @id @default(cuid())
  laborLogId String   @unique
  laborLog   LaborLog @relation(fields: [laborLogId], references: [id], onDelete: Cascade)
  imageData  String   @db.Text // base64 data URL, compressed client-side before upload
  createdAt  DateTime @default(now())
}
